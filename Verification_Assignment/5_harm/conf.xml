<harm>
    <context name="default">
        <template name="water_delivery" exp="G({harm_btn == 1} |-> ##[1:5] {harm_bev == 1})"/>
        <template name="soda_delivery" exp="G({harm_btn == 2} |-> ##[1:5] {harm_bev == 2})"/>

        <numeric clustering="K,10Max,0.01WCSS,><,==" exp="harm_bev" loc="c,dt"/>
        <numeric clustering="K,10Max,0.01WCSS,><,==" exp="harm_btn" loc="c,dt"/>
        <prop exp="rst" loc="c,dt"/>

        <template dtLimits="5D,3W,15A,-0.1E,U" exp="G({..#1&..}|-> P0)" /> 

        <sort name="causality" exp="1-afct/traceLength"/>
        <sort name="frequency" exp="atct/traceLength"/>
    </context>
</harm>