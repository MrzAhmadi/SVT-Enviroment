<harm>
    <context name="random_tb_top::clk">
        
        <propositions>
            <prop name="p0" loc="c">button_in == 1</prop>
            <prop name="p1" loc="c">beverage_out == 1</prop>
            <prop name="p2" loc="c">button_in == 2</prop>
            <prop name="p3" loc="c">beverage_out == 2</prop>
        </propositions>

        <templates>
            <template name="t1" text="G({..p0..} |-&gt; ##2 {..p1..})"/>
            <template name="t2" text="G({..p2..} |-&gt; ##2 {..p3..})"/>
        </templates>

        <sort name="frequency" exp="atct"/>
    </context>
</harm>